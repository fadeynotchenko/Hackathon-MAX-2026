# =============================================================================
# MAX mini app — пример окружения (сгенерирован, руками не править).
#
# Источник правды: core/src/core/config/env_spec.py
# Перегенерация:   cd core && uv run python -m core.scripts.gen_env_example
# Проверка:        cd core && uv run python -m core.scripts.gen_env_example --check
#
# Скопируй в .env и заполни значения. [required: ...] — без переменной
# перечисленные сервисы не стартуют. Секреты здесь — плейсхолдеры.
# =============================================================================

# --- Окружение / логи --------------------------------------------
# Имя окружения; production ⇒ прод-режим (secure-cookie, без CORS для localhost). [optional; str]
#   owner: core.config.app_config; bot/src/config.ts
ENV=dev

# Уровень логирования. [optional; str]
#   owner: core.logs.setup; bot/src/logger.ts
LOG_LEVEL=INFO

# Формат логов: auto (json вне TTY, pretty в терминале) | json | pretty. [optional; str]
#   owner: core.logs.setup; bot/src/logger.ts
LOG_FORMAT=auto

# Каталог файловых логов (посуточная ротация, gzip). Пусто ⇒ только stdout. [optional; str]
#   owner: core.logs.setup; bot/src/logger.ts
LOG_DIR=app_logs

# Публичный https-адрес стенда. Нужен боту в режиме webhook и для ссылок. [optional; url]
#   owner: bot/src/config.ts; AppConfig
PUBLIC_BASE_URL=https://maxapp.example.tld

# Доменное имя для server_name nginx (прод-compose). [required: compose; str]
#   owner: gateway/templates/default.conf.template
DOMAIN=maxapp.example.tld


# --- Платформа MAX -----------------------------------------------
# Токен бота от MasterBot. Один и тот же секрет подписывает initData мини-аппа. [required: api, bot; secret]
#   note: С плейсхолдером мини-апп на локали работает (dev-вход), бот — нет: MAX ответит 401.
#   owner: core.usecases.auth.config; bot/src/config.ts
MAX_BOT_TOKEN=dev-only-bot-token-replace-with-masterbot-token

# Имя мини-приложения для кнопки open_app. Пусто ⇒ мини-апп бота по умолчанию. [optional; str]
#   owner: bot/src/config.ts
MAX_MINI_APP_NAME=

# Список user_id администраторов (JSON-массив или CSV). [optional; list]
#   owner: core.config.app_config
ADMIN_MAX_IDS=[123456789]


# --- Бот (TypeScript) --------------------------------------------
# polling (dev) | webhook (прод за nginx). [optional; str]
#   owner: bot/src/config.ts
BOT_MODE=polling

# Путь вебхука; nginx проксирует его в контейнер бота. [optional; str]
#   owner: bot/src/config.ts; gateway/templates/default.conf.template
BOT_WEBHOOK_PATH=/bot/webhook

# Секрет вебхука: MAX присылает его в заголовке x-max-bot-api-secret. [optional; secret]
#   note: Обязателен при BOT_MODE=webhook (проверяет zod-схема бота).
#   owner: bot/src/config.ts
BOT_WEBHOOK_SECRET=dev-only-webhook-secret-0123456789

# Порт HTTP-сервера вебхука внутри контейнера. [optional; int]
#   owner: bot/src/config.ts
BOT_WEBHOOK_PORT=8080

# Порт эндпоинта /health бота (docker healthcheck). [optional; int]
#   owner: bot/src/health.ts
BOT_HEALTH_PORT=8081

# TTL сессии пользователя в Redis. [optional; int]
#   owner: bot/src/session/redis-store.ts
BOT_SESSION_TTL_SECONDS=604800


# --- PostgreSQL --------------------------------------------------
# Хост PostgreSQL (в compose — сервис db). [optional; str]
#   owner: core.db.config
DB_HOST=db

# Порт PostgreSQL. [optional; int]
#   owner: core.db.config
DB_PORT=5432

# Пользователь БД. [required: api, compose; str]
#   owner: core.db.config; docker-compose (POSTGRES_USER)
DB_USER=maxapp

# Пароль БД. [required: api, compose; secret]
#   owner: core.db.config; docker-compose (POSTGRES_PASSWORD)
DB_PASSWORD=dev-only-db-password

# Имя БД. [required: api, compose; str]
#   owner: core.db.config; docker-compose (POSTGRES_DB)
DB_NAME=maxapp

# Размер пула соединений на процесс. [optional; int]
#   owner: core.db.config
DB_POOL_SIZE=5

# Overflow-соединения сверх пула. [optional; int]
#   owner: core.db.config
DB_MAX_OVERFLOW=10

# Ожидание свободного соединения из пула (сек). [optional; int]
#   owner: core.db.config
DB_POOL_TIMEOUT=10

# Пересоздание соединения (сек). [optional; int]
#   owner: core.db.config
DB_POOL_RECYCLE=1800

# statement_timeout PostgreSQL (мс). [optional; int]
#   owner: core.db.config
DB_STATEMENT_TIMEOUT_MS=30000

# DSN тестового PostgreSQL для tests/integration (docker-compose.test.yml). [optional; url]
#   note: Только для тестов.
#   owner: core/tests (integration)
TEST_DATABASE_URL=postgresql+asyncpg://maxapp:maxapp@localhost:5544/maxapp_test


# --- Redis -------------------------------------------------------
# Хост Redis (в compose — сервис redis). [optional; str]
#   owner: core.db.redis; bot/src/config.ts
REDIS_HOST=redis

# Порт Redis. [optional; int]
#   owner: core.db.redis; bot/src/config.ts
REDIS_PORT=6379

# Пароль Redis (прод-compose поднимает redis с --requirepass). [required: compose; secret]
#   owner: core.db.redis; bot/src/config.ts; docker-compose.prod.yml
REDIS_PASSWORD=dev-only-redis-password

# Номер логической БД Redis. [optional; int]
#   owner: core.db.redis; bot/src/config.ts
REDIS_DB=0

# URL тестового Redis для tests/integration. [optional; url]
#   note: Только для тестов.
#   owner: core/tests (integration)
TEST_REDIS_URL=redis://localhost:6544/0


# --- Аутентификация мини-аппа ------------------------------------
# Секрет подписи access-токенов (не короче 32 символов). [required: api; secret]
#   note: Сгенерировать: openssl rand -hex 32.
#   owner: core.usecases.auth.config
JWT_SECRET=dev-only-jwt-secret-change-in-production-0123456789

# Время жизни access-токена. [optional; int]
#   owner: core.usecases.auth.config
ACCESS_TOKEN_TTL_SECONDS=900

# Время жизни refresh-токена (cookie). [optional; int]
#   owner: core.usecases.auth.config
REFRESH_TOKEN_TTL_SECONDS=2592000

# Максимальный возраст initData мини-аппа (auth_date). Утёкшая строка initData даёт вход всё это время. [optional; int]
#   owner: core.usecases.auth.config
INIT_DATA_MAX_AGE_SECONDS=3600

# Ручка GET /dev/init-data (вход тестовым пользователем без клиента MAX). Только dev-стенд. [optional; bool]
#   note: В production запрещена валидатором: с ней любой получает сессию любого пользователя.
#   owner: core.config.app_config; core.api.main
DEV_LOGIN_ENABLED=false

# Дополнительные CORS-origin'ы (CSV). В dev localhost разрешён и так. [optional; list]
#   owner: core.config.app_config; core.api.main
CORS_ALLOW_ORIGINS=


# --- API ---------------------------------------------------------
# Серверный таймаут одного HTTP-запроса (504 при превышении). [optional; int]
#   owner: api/middlewares/timeout.py
API_REQUEST_TIMEOUT_SECONDS=30

# Число uvicorn-воркеров в проде. [optional; int]
#   note: Больше одного — только с LOG_DIR= (файл-лог не умеет ротироваться из нескольких процессов; логи тогда через docker stdout).
#   owner: docker-compose.prod.yml
API_WORKERS=1


# --- Шина событий (Redis Streams) --------------------------------
# Redis Stream событий ядро → бот (notify.user и т.п.). [optional; str]
#   owner: core.events.config; bot/src/config.ts
EVENTS_STREAM_TO_BOT=maxapp:to_bot

# Redis Stream событий бот → core (bot.user_started и т.п.); читает воркер внутри api. [optional; str]
#   owner: core.events.config; bot/src/config.ts
EVENTS_STREAM_TO_CORE=maxapp:to_core

# Приблизительная длина стрима (XADD MAXLEN ~). [optional; int]
#   owner: core.events.config; bot/src/config.ts
EVENTS_STREAM_MAXLEN=10000


# --- Бэкапы и деплой ---------------------------------------------
# Час UTC суточного pg_dump в проде. [optional; int]
#   owner: docker-compose.prod.yml (db_backup)
DB_BACKUP_HOUR_UTC=3

# Сколько суточных дампов хранить. [optional; int]
#   owner: docker-compose.prod.yml (db_backup)
DB_BACKUP_KEEP=14

# Сколько predeploy-снимков хранить. [optional; int]
#   owner: deploy.sh
PREDEPLOY_KEEP=10

# 1 ⇒ deploy.sh не гоняет тесты перед выкаткой (только если они зелёные в CI). [optional; bool]
#   note: Читается только скриптом деплоя, в .env не нужна.
#   owner: deploy.sh
SKIP_TESTS=0


# --- Порты на хосте (compose) ------------------------------------
# HTTP-порт gateway на хосте (только прод: ACME http-01 и редирект на https). [optional; int]
#   owner: docker-compose.prod.yml (gateway)
GATEWAY_HTTP_PORT=80

# HTTPS-порт gateway на хосте (только прод). [optional; int]
#   owner: docker-compose.prod.yml (gateway)
GATEWAY_HTTPS_PORT=443

# Порт API на хосте в dev (мини-апп ходит через vite-proxy, это прямой доступ). [optional; int]
#   owner: docker-compose.dev.yml (api)
DEV_API_PORT=8091

# Порт мини-аппа (vite dev-server) на хосте в dev: http://localhost:<порт>. [optional; int]
#   owner: docker-compose.dev.yml (web)
DEV_WEB_PORT=3090

# Порт PostgreSQL на хосте в dev. [optional; int]
#   owner: docker-compose.dev.yml (db)
DEV_DB_PORT=5490

# Порт Redis на хосте в dev. [optional; int]
#   owner: docker-compose.dev.yml (redis)
DEV_REDIS_PORT=6490


# --- Мини-апп (build-time, Vite) ---------------------------------
# База API для мини-аппа. Пусто ⇒ same-origin (/api/v1 через nginx или vite-proxy). [optional; str]
#   owner: web/src/api/client.ts
VITE_API_BASE_URL=

# Куда vite dev-server проксирует /api/ (в docker — http://api:8000). [optional; url]
#   owner: web/vite.config.ts
VITE_PROXY_TARGET=http://localhost:8000

# Подписанный initData для запуска мини-аппа в обычном браузере (dev). [optional; str]
#   note: Сгенерировать: uv run python -m core.scripts.dev_init_data. Только dev.
#   owner: web/src/max/webapp.ts
VITE_DEV_INIT_DATA=
