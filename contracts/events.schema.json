{
  "$comment": "Сгенерировано core/src/core/scripts/export_event_schemas.py из core.events.contracts. Руками не править.",
  "envelope": {
    "properties": {
      "id": {
        "description": "UUID события (hex, 32 символа)",
        "type": "string"
      },
      "payload": {
        "description": "JSON-объект, форма — events[type]",
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "ts": {
        "format": "date-time",
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "v": {
        "description": "Версия конверта, число в строке (поля стрима — строки)",
        "type": "string"
      }
    },
    "required": [
      "id",
      "v",
      "type",
      "payload",
      "ts",
      "source"
    ],
    "type": "object"
  },
  "envelope_version": 1,
  "events": {
    "bot.attachment": {
      "additionalProperties": false,
      "description": "Бот → ядро: пользователь прислал фото, файл или голосовое.\n\nБайты в событие не кладутся, как и в ``document.ready``: ссылку на файл\nдаёт MAX, ядро скачивает его само. ``text`` — подпись к вложению.",
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "integer"
        },
        "filename": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filename"
        },
        "first_name": {
          "default": "",
          "title": "First Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "file",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "max_user_id": {
          "exclusiveMinimum": 0,
          "title": "Max User Id",
          "type": "integer"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 9,
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        }
      },
      "required": [
        "max_user_id",
        "chat_id",
        "kind",
        "url"
      ],
      "title": "BotAttachment",
      "type": "object"
    },
    "bot.callback": {
      "additionalProperties": false,
      "description": "Бот → ядро: пользователь нажал кнопку, которую ядро прислало в notify.user.",
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "integer"
        },
        "max_user_id": {
          "exclusiveMinimum": 0,
          "title": "Max User Id",
          "type": "integer"
        },
        "payload": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Payload",
          "type": "string"
        }
      },
      "required": [
        "max_user_id",
        "chat_id",
        "payload"
      ],
      "title": "BotCallback",
      "type": "object"
    },
    "bot.message": {
      "additionalProperties": false,
      "description": "Бот → ядро: пользователь написал боту текст, а не команду.",
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "integer"
        },
        "first_name": {
          "default": "",
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "max_user_id": {
          "exclusiveMinimum": 0,
          "title": "Max User Id",
          "type": "integer"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        }
      },
      "required": [
        "max_user_id",
        "chat_id",
        "text"
      ],
      "title": "BotMessage",
      "type": "object"
    },
    "bot.user_started": {
      "additionalProperties": false,
      "description": "Бот → ядро: пользователь нажал «Начать» (update bot_started).",
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "integer"
        },
        "first_name": {
          "default": "",
          "title": "First Name",
          "type": "string"
        },
        "language_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language Code"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "max_user_id": {
          "exclusiveMinimum": 0,
          "title": "Max User Id",
          "type": "integer"
        },
        "start_payload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Payload"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        }
      },
      "required": [
        "max_user_id",
        "chat_id"
      ],
      "title": "BotUserStarted",
      "type": "object"
    },
    "document.ready": {
      "additionalProperties": false,
      "description": "Ядро → бот: отдать пользователю готовый файл документа.\n\nБайты в событие не кладутся: стрим — не файловое хранилище. Вместо них\nодноразовый ``download_token``, по которому бот забирает файл у ядра.",
      "properties": {
        "document_id": {
          "exclusiveMinimum": 0,
          "title": "Document Id",
          "type": "integer"
        },
        "download_token": {
          "maxLength": 128,
          "minLength": 16,
          "title": "Download Token",
          "type": "string"
        },
        "filename": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "format": {
          "enum": [
            "docx",
            "pdf"
          ],
          "title": "Format",
          "type": "string"
        },
        "max_user_id": {
          "exclusiveMinimum": 0,
          "title": "Max User Id",
          "type": "integer"
        },
        "size": {
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "title": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "max_user_id",
        "document_id",
        "title",
        "filename",
        "format",
        "size",
        "download_token",
        "text"
      ],
      "title": "DocumentReady",
      "type": "object"
    },
    "notify.user": {
      "$defs": {
        "InlineButton": {
          "additionalProperties": false,
          "description": "Кнопка под сообщением: нажатие возвращается в ядро событием bot.callback.",
          "properties": {
            "payload": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Payload",
              "type": "string"
            },
            "text": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "text",
            "payload"
          ],
          "title": "InlineButton",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Ядро → бот: отправить пользователю сообщение в MAX.",
      "properties": {
        "buttons": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "$ref": "#/$defs/InlineButton"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Buttons"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "markdown",
                "html"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "max_user_id": {
          "exclusiveMinimum": 0,
          "title": "Max User Id",
          "type": "integer"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "max_user_id",
        "text"
      ],
      "title": "NotifyUser",
      "type": "object"
    }
  }
}
